# ============================================================
# SheetSmart environment variables
# ------------------------------------------------------------
# Copy this file to ".env" and fill in the values. The ".env"
# file is git-ignored and must NEVER be committed.
# Every value here is explained in plain English in README.md.
# ============================================================

# The password you type to open SheetSmart in a browser.
# Choose something strong and keep it in your password manager.
ADMIN_PASSWORD=change-me-before-first-run

# A long random string used to sign your login cookie.
# Any long random text is fine; generate one and forget it.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the web server listens on locally (Render sets this for you).
PORT=3000

# ------------------------------------------------------------
# Google service account (Section 9A of the handoff).
# Paste the ENTIRE service-account JSON key as ONE base64 line.
# The README shows exactly how to create this value. Leave it
# blank for now — the app still runs and shows "Not connected".
# ------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# ------------------------------------------------------------
# Where the SQLite database file lives. On Render this must point
# at the persistent disk (e.g. /var/data/sheetsmart.sqlite) so run
# history survives restarts. Locally the default below is fine.
# ------------------------------------------------------------
DATABASE_PATH=./data/sheetsmart.sqlite

# ------------------------------------------------------------
# Mapbox token — ONLY used to read your zone-polygon dataset for the
# read-only Zone Health check (Workflow A). Create a token with the
# "datasets:read" scope at https://account.mapbox.com/access-tokens/
# (datasets:read is a PUBLIC scope, so the token starts with "pk.").
# Still treat it like a credential and keep it out of git. The
# (non-secret) Mapbox username + dataset id are set in the app UI
# under Zone Health, not here. Leave blank until you build zones.
# ------------------------------------------------------------
MAPBOX_TOKEN=
